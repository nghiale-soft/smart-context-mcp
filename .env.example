# Smart Context MCP Configuration

# Low AI Provider: groq | gemini | ollama
LOW_AI_PROVIDER=groq
LOW_AI_API_KEY=your_low_ai_api_key_here
LOW_AI_MODEL=llama-3.3-70b-versatile

# Storage & Cache Path
CACHE_DB_PATH=./.cache/smart_context.db

# Web Dashboard Port
DASHBOARD_PORT=3333
ENABLE_DASHBOARD=true
